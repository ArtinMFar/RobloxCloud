+/// One line for `editor`: `ok focus=0`, or the box's surface rectangle, font
+/// size, whether it masks its text, the caret and the text, percent-encoded so
+/// it stays one line.
+fn editor_line() -> String {
+    if cordial_linker_sys::game_activity::focused_textbox().is_none() {
+        return "ok focus=0".into();
+    }
+    let (text, caret) = crate::android::input::text_buffer_peek();
+    let mut enc = String::with_capacity(text.len() * 3);
+    for b in text.bytes() {
+        if b.is_ascii_alphanumeric() || b"-_.~".contains(&b) {
+            enc.push(b as char);
+        } else {
+            enc.push_str(&format!("%{b:02X}"));
+        }
+    }
+    match cordial_linker_sys::game_activity::focused_textbox_info() {
+        Some(i) => format!(
+            "ok focus=1 x={} y={} w={} h={} size={} password={} multiline={} xalign={} caret={caret} text={enc}",
+            i.x, i.y, i.width, i.height, i.font_size,
+            // The values `wayland.rs` masks on (Roblox's own enum, slot 10).
+            u8::from(matches!(i.text_input_type, 5 | 9 | 10)),
+            i.multiline, i.x_alignment,
+        ),
+        None => format!("ok focus=1 x=none caret={caret} text={enc}"),
+    }
+}
