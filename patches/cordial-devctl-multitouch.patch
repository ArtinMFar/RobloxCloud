+                // (`closeWindow`), and that path does not end in `closed`:
+                // without this the empty host window stayed on top of the
+                // game as a blank white screen.
+                let window = host.clone();
+                dialog.connect_unmap(move |_| window.close());
+            }
+            None => {
+                host.close();
+                println!("[webview] openWindow request was refused by policy before it could be presented");
+            }
+        }
+    }
+}
