+/// for good and advances it once per tick (nothing else iterates it on X11, and
+/// sources such as the battery report were already attached to it from this
+/// thread), so the presenter's `invoke`s land on the pump thread, which brings
+/// GTK up for X11 on first use and opens each request in a plain top-level
+/// window holding the same dialog the Wayland path shows.
+#[cfg(feature = "webview")]
+mod x11_web {
+    use gtk4::glib;
+    use gtk4::prelude::*;
+
+    /// On the pump thread, before the pump starts.
+    pub fn arm() {
+        match glib::MainContext::default().acquire() {
+            // Held for the life of the process: the pump thread is GTK's now.
+            Ok(guard) => std::mem::forget(guard),
+            Err(e) => {
+                println!("  webview: could not take GLib's main context ({e}); web views stay unavailable");
+                return;
+            }
+        }
+        let _ = cordial_runtime::android::looper::TICK.set(|| {
+            let context = glib::MainContext::default();
+            for _ in 0..64 {
+                if !context.iteration(false) {
+                    break;
+                }
+            }
+        });
+        println!("  webview: no Wayland host window; web views will open in their own X11 window");
+    }
+
+    fn gtk_up() -> bool {
+        static UP: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *UP.get_or_init(|| {
+            // SAFETY: set before GTK is initialised, on the thread that is
+            // about to do it; nothing else here reads GDK's variables.
+            if let Err(e) = unsafe { glib::setenv("GDK_BACKEND", "x11", true) } {
+                println!("[webview] could not set GDK_BACKEND=x11: {e}");
+            }
+            gtk4::gdk::set_allowed_backends("x11");
+            // Not "Cordial": that WM_CLASS names the game window.
+            glib::set_prgname(Some("cordial-web"));
+            match libadwaita::init() {
+                Ok(()) => true,
+                Err(e) => {
+                    println!("[webview] GTK would not start on X11, so web views stay unavailable: {e}");
+                    false
+                }
+            }
+        })
+    }
